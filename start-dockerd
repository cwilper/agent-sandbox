#!/bin/sh
# start-dockerd — bring up dockerd inside a smolvm guest.
#
# Installed to /usr/local/bin/start-dockerd (mode 0755) by the Dockerfile.
# Run as root after every `machine start`:
#   smolvm machine exec --name sandbox -- sudo start-dockerd
#
# Idempotent: safe to run when the daemon is already up.

set -e

DATA=/storage/docker
TARGET=/var/lib/docker
LOG=/var/log/dockerd.log
SOCK_GROUP=agent

# smolvm regenerates /etc/hosts on boot, so the create-time entry may be gone.
# Without it every sudo prints "unable to resolve host". Cosmetic, but noisy.
if ! grep -q "$(hostname)" /etc/hosts 2>/dev/null; then
    echo "127.0.1.1 $(hostname)" >> /etc/hosts
fi

if docker info >/dev/null 2>&1; then
    echo "dockerd already running"
    exit 0
fi

# The bind-mount does not survive stop/start, so re-apply it each boot.
# Without it dockerd lands on the rootfs overlay and overlay2 is rejected
# (ramfs lower layer -> no file handles -> index=off).
mkdir -p "$DATA" "$TARGET"
mountpoint -q "$TARGET" || mount --bind "$DATA" "$TARGET"

# Stale pidfile from an unclean shutdown blocks startup.
rm -f /var/run/docker.pid

# --group sets the group owning /var/run/docker.sock. Using agent's PRIMARY
# group rather than the `docker` supplementary group means access works even
# if the exec session doesn't initialize supplementary groups.
dockerd --group "$SOCK_GROUP" --storage-driver=overlay2 >"$LOG" 2>&1 &

i=0
while [ "$i" -lt 30 ]; do
    if docker info >/dev/null 2>&1; then
        docker info 2>/dev/null | grep "Storage Driver"
        exit 0
    fi
    i=$((i + 1))
    sleep 1
done

echo "start-dockerd: daemon did not come up within 30s" >&2
tail -n 30 "$LOG" >&2
exit 1
